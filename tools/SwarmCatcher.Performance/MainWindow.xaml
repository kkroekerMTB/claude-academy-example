<Window x:Class="SwarmCatcher.Performance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SwarmCatcher.Performance"
        Title="Swarm Catcher Performance"
        Background="#101820"
        WindowState="Maximized"
        WindowStyle="None"
        KeyDown="WindowKeyDown">
    <Grid>
        <local:SwarmSurface x:Name="Swarm" />

        <Border Margin="24"
                Padding="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#DD101820"
                CornerRadius="8">
            <StackPanel>
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#FFD44A"
                           Text="5,000-bee tracer bullet" />
                <TextBlock x:Name="MetricsText"
                           Margin="0,8,0,0"
                           FontFamily="Consolas"
                           FontSize="16"
                           Foreground="White"
                           Text="Starting…" />
                <TextBlock Margin="0,10,0,0"
                           Foreground="#CDD5DB"
                           Text="Press Esc to exit" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
